{
  "$version": "0.2.0",
  "$description": "Tokens canónicos de ZENTRIKA, alineados con la referencia visual aprobada (nov-2026). tokens.css se mantiene sincronizado con este archivo.",
  "brand": {
    "name": "ZENTRIKA",
    "slogan": "Ingeniería que transforma ideas.",
    "sloganAccentWord": "transforma"
  },
  "locale": {
    "default": "es-CO",
    "country": "CO",
    "currency": "COP",
    "timezone": "America/Bogota"
  },
  "color": {
    "blue": "#3B82FF",
    "indigo": "#6366F1",
    "violet": "#8B5CF6",
    "sky": "#45B4FF",
    "white": "#FFFFFF",
    "snow": "#F8FAFC",
    "obsidian": "#080F1A",
    "obsidian-2": "#0B1222",
    "gradient": "linear-gradient(135deg, #3B82FF 0%, #6366F1 60%, #8B5CF6 100%)",
    "gradient-iso": "linear-gradient(225deg, #2A66FF 0%, #2450EE 50%, #6366F1 82%, #8B5CF6 100%)"
  },
  "font": {
    "display": "'Manrope Variable', 'Manrope', system-ui, sans-serif",
    "body": "'Inter Variable', 'Inter', system-ui, sans-serif"
  },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "22px", "pill": "999px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "logo": {
    "minHeightIsotipoPx": 16,
    "minHeightHorizontalPx": 20,
    "clearSpace": "Altura de la barra superior del isotipo (≈25 % de su alto) por cada lado"
  }
}
